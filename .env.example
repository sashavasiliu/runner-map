# Copy this file to ".env" and fill in the values.
# Get the client ID and secret at https://www.strava.com/settings/api

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Any long random string; used to sign the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000
# Public address of the app. Its host must match the
# "Authorization Callback Domain" in your Strava API settings (localhost for local use).
BASE_URL=http://localhost:3000
